{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/routes/**/{+page,+page.server,+layout,+layout.server,+server}.{ts,js,svelte}",
    "src/hooks.server.{ts,js}",
    "src/lib/index.{ts,js}",
    "src/lib/server/*.{ts,js}",
    "tests/**/*.test.{ts,js}",
    "tests/e2e/global-setup.ts",
    "tests/integration/setup.ts",
    "tests/stubs/*.{ts,js}"
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "health": {
    "maxCognitive": 20
  },
  // Vite inlines every devDependency into the build output, and moving a package
  // to "dependencies" is what makes Vite externalise it. The rule therefore only
  // reports the manifest layout back to itself and carries no signal here.
  "rules": {
    "dev-dependencies-in-production": "off"
  }
}
